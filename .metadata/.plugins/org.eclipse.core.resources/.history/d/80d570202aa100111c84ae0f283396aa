package com.edu.springboot;

import org.springframework.beans.factory.annotation.Autowired;
import org.springframework.stereotype.Controller;
import org.springframework.ui.Model; // 올바른 Model 패키지
import org.springframework.web.bind.annotation.GetMapping;
import org.springframework.web.bind.annotation.PostMapping;

import com.edu.springboot.jdbc.MemberDAO;
import com.edu.springboot.jdbc.MemberDTO;

@Controller
public class MainController {

	// DAO 빈 자동주입 (필드 상단 배치)
	@Autowired
	private MemberDAO dao;

	@GetMapping("/")
	public String main() {
		return "main";	
	}
	
	// 회원목록
	@GetMapping("/list.do")
	public String member1(Model model) {
		model.addAttribute("memberList", dao.select());
		return "list";
	}
	
	//회원정보입력1 : 입력페이지 매핑
	@GetMapping("/regist.do")
	public String member2() {
		return "regist";
	}
	
	//회원정보입력2 : insert 쿼리문으로 입력 처리
	@PostMapping("/regist.do")
	public String member3(MemberDTO memberDTO) {
		int result = dao.insert(memberDTO);
		if(result==1) System.out.println("입력되었습니다.");
		return "redirect:list.do";
	}
	
	//회원정보수정1 : 기존의 회원레코드 인출
	@GetMapping("/edit.do")
	public String member4(MemberDTO memberDTO, Model model) {
		memberDTO = dao.selectOne(memberDTO);
		model.addAttribute("dto", memberDTO);
		return "edit";
	}
	
	//삭제 처리 : delete 쿼리문으로 삭제 처리
	@GetMapping("/delete.do")
	public String member6(MemberDTO memberDTO) {
		int result = dao.delete(memberDTO);
		if(result==1) System.out.println("삭제되었습니다.");
		return "redirect:list.do";
	}
}
