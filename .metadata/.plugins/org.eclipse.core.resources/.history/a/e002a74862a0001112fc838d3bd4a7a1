package com.edu.springboot;

import org.springframework.stereotype.Controller;
import org.springframework.ui.Model; // Correct import
import org.springframework.web.bind.annotation.GetMapping;
import org.springframework.web.bind.annotation.ModelAttribute;
import org.springframework.web.bind.annotation.PathVariable;
import org.springframework.web.bind.annotation.RequestParam;

import jakarta.servlet.http.HttpServletRequest;

@Controller
public class MainController {
	
	// root 경로에 대한 매핑 
	@GetMapping("/")
	public String main() {
		return "main";
	}
	
	// 요청시 templates 하위의 indexT.html 파일 렌더링
	@GetMapping("/index.do")
	public String index() {
		return "indexT";
	}
	
	// 하위 경로가 필요한 경우 sub/와 같이 작성 가능 
	@GetMapping("/sub.do")
	public String sub() {
		return "sub/subT";
	}
	
	@GetMapping("/form1.do")
	public String form1(HttpServletRequest httpServletRequest, Model model) {
		String name = httpServletRequest.getParameter("name");
		String age = httpServletRequest.getParameter("age");
		model.addAttribute("name", name);
		model.addAttribute("age", age);
		return "form/submit1";
	}
	
	/*
	방법2 : @RequestParam 어노테이션 사용. 어노테이션으로 받은 후 즉시 변수에 저장하는 부분을 매개변수 형식으로 작성. */
	@GetMapping("/form2.do")
	public String form2(Model model,
			@RequestParam("name") String name,
			@RequestParam(value = "age", required = false, defaultValue = "99") String age) {
		//폼값은 모두 매개변수쪽에 처리되엇으므로 Model객체에만 저장 후 View로 전달 
		model.addAttribute("name", name);
		model.addAttribute("age", age);
		return "form/submit3";
	}
	
	/*
	방법3 : 경로변수 즉 @Pathvariable 어모테이션 사용. 경로 형식으로 전달되는 파라미터를 받아서 변수에 저장하는 방식 */
	@GetMapping("/form3/{name}/{age}")
	public String form3(@PathVariable("name") String name,
	                    @PathVariable("age") String age,
	                    Model model) {
	    model.addAttribute("name", name);
	    model.addAttribute("age", age);
	    return "form/submit3"; // 렌더링할 HTML 템플릿 경로
	}
	
	/*
	방법4 : 커맨드객체를 통해 모든 폼값을 한번에 받는 방법. 쿼리스트링의 Key로 사용된 이름과, DTO클래스의 멤버변수명이 
	일치하면 폼값이 자동ㅇ르ㅗ 바이딩되어 저장된다. */
	@GetMapping("/form4.do")
	public String form4(PersonDTO personDTO) {
		return "form/submit4";
	}
	
	@GetMapping("/form5.do")
	public String form5(@ModelAttribute("p") PersonDTO personDTO) {
	    return "form/submit5";
	}
}
