package com.edu.springboot;

import org.springframework.stereotype.Controller;
import org.springframework.web.bind.annotation.GetMapping;

@Controller
public class MainController {
	
	//root 경로에 대한 매핑 
	@GetMapping("/")
	public String main() {
		return "main";
	}
	//요청시 templates 하위의 indexT.html 파일 렌더링
	@GetMapping("/index.do")
	public String index() {
		return "indexT";
	}
	//하위 경로가 필요한 경우 sub/와 같이 작성 가능 
	@GetMapping("/sub.do")
	public String sub() {
		return "sub/subT";
	}
}
