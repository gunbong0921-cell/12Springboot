package com.edu.springboot;

import org.springframework.stereotype.Controller;
import org.springframework.web.bind.annotation.GetMapping;

@Controller
public class MainController {
	
	//root 경로에 대한 매핑 
	@GetMapping("/")
	public String main() {
		return "main";
	}
	
	@GetMapping("/index.do")
	public String index() {
		return "indexT";
	}
	
	@GetMapping("/sub.do")
	public String sub() {
		return "sub/subT";
	}
	
	@GetMapping("/sub/subS.do") // 혹은 요청 URL 형태에 맞게 설정
	public String subS() {
	    return "sub/subS"; // src/main/resources/templates/sub/subS.html 을 찾아감
	}
}
