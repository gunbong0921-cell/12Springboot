package com.edu.springboot.jdbc;

import java.sql.Connection;
import java.sql.PreparedStatement;
import java.sql.SQLException;
import java.util.List;

import org.springframework.beans.factory.annotation.Autowired;
import org.springframework.jdbc.core.BeanPropertyRowMapper;
import org.springframework.jdbc.core.JdbcTemplate;
import org.springframework.jdbc.core.PreparedStatementCreator;
import org.springframework.jdbc.core.PreparedStatementSetter;
import org.springframework.stereotype.Repository;

/*
DB 저장소 역할의 클래스이므로 @Repository 어노테이션을 부착. 스프링 컨테이너가 시작될때 자동으로 빈으로 생성된다.
DAO는 Data Access Object의 약자로 DB접근을 위해 생성한다. */
@Repository
public class MemberDAO {

	/*
	JdbcTemplate 빈을 자동주입 받음. 프로젝트 생성시 JDBC API를 의존 추가 했으므로
	별도의 설정없이 바로 사용 가능함. */
	@Autowired
	private JdbcTemplate jdbcTemplate;
	
	// 회원목록
	public List<MemberDTO> select() {
		// 회원 레코드를 가입일을 기준으로 내림차순 정렬 후 인출 
		String sql = "SELECT * FROM member ORDER BY regidate DESC";
		return jdbcTemplate.query(sql, new BeanPropertyRowMapper<MemberDTO>(MemberDTO.class));
	}
	
	// 회원입력
	public int insert(MemberDTO memberDTO) {
		/*
		update()메서드 : insert, update, delete와 같이 행의 변화가 발생되는 쿼리문을 실행할 때 사용한다.
		실행 후 적용된 행의 갯수가 반환된다. */
		int result = jdbcTemplate.update(new PreparedStatementCreator() {
			/*
			PreparedStatementCreator 인터페이스로 익명클래스를 생성한 후 오버라이딩 된 메서드내에서 인파라미터가 있는 insert
			쿼리문을 실행한다. */
			@Override
			public PreparedStatement createPreparedStatement(Connection con) throws SQLException {
				//인파라미터가 있는 쿼리문을 작성
				String sql = "INSERT INTO member (id, pass, name) VALUES (?, ?, ?)";
				//인파라미터 세팅 후 쿼리문을 실행 
				PreparedStatement psmt = con.prepareStatement(sql);
				psmt.setString(1, memberDTO.getId());
				psmt.setString(2, memberDTO.getPass());
				psmt.setString(3, memberDTO.getName());
				return psmt;
			}
		});
		//insert 쿼리문 실행 후 결과를 컨트롤러로 반환 
		return result;
	}
	
	// 수정을 위해 기존의 회원정보 인출하기
	public MemberDTO selectOne(MemberDTO memberDTO) {
		String sql = "SELECT * FROM member WHERE id=?";
		try {
			// Deprecated된 new Object[] 배열 대신 가변인자로 넘김
			/*
			queryForObject() : 하나의 결과를 반호나하는 select 쿼리문을 실행행할때 사용하는 매서드
			 인수1 : 쿼리문
			 인수2 : RowMapper를 통해 인출한 ResultSet을 DTO에 저장
			 인수3 : 인파라미터에 설정할 값을 Object형 배열로 선언하여 순서대로 설정한다. */
			memberDTO = jdbcTemplate.queryForObject(
				sql, 
				new BeanPropertyRowMapper<MemberDTO>(MemberDTO.class),
				memberDTO.getId()
			);
		} 
		catch (Exception e) {
			e.printStackTrace();
		}
		return memberDTO;
	}
	
	// 회원정보 수정 처리
	public int update(MemberDTO memberDTO) {
		String sql = "UPDATE member SET pass=?, name=? WHERE id=?";
		// [수정] 마침표(.)를 콤마(,)로 변경
		int result = jdbcTemplate.update(sql, new PreparedStatementSetter() {
			@Override
			public void setValues(PreparedStatement ps) throws SQLException {
				ps.setString(1, memberDTO.getPass());
				ps.setString(2, memberDTO.getName());
				ps.setString(3, memberDTO.getId());
			}
		});
		return result;
	}
	
	//회원정보삭제
	public int delete(MemberDTO memberDTO) {
		String sql = "delete from member where id=?";
		int result = jdbcTemplate.update(sql, new Object[] {memberDTO.getId()});
		return result;
	}
}
